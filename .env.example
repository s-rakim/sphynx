# Copy to .env and edit. Everything here is optional: you can do all of it
# in the web UI instead.

# Time zone for logs, e.g. America/New_York or Europe/Berlin.
TZ=UTC

# Admin password (at least 8 characters). Leave empty to choose it the
# first time you open http://localhost:3000.
SPHYNX_ADMIN_PASSWORD=

# The address devices use to reach Sphynx. Examples:
#   http://192.168.1.20:8080      (home network only)
#   https://vpn.example.com       (from anywhere, with HTTPS turned on)
SPHYNX_SERVER_URL=
